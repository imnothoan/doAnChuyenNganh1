# UTF-8 locale (Linux/macOS)
PYTHONIOENCODING=utf-8

# Data/process config
MIN_TEXT_LENGTH=20
RANDOM_STATE=42
VAL_SIZE=0.15
TEST_SIZE=0.15
ALLOWED_NEWS_DOMAINS=vnexpress.net,tuoitre.vn,thanhnien.vn

# Supabase (optional)
# Use the project URL, not the /rest/v1 endpoint.
# Example: https://your-project-ref.supabase.co
SUPABASE_URL=

# Use anon/publishable key for the app. Never commit service_role/secret keys.
SUPABASE_KEY=
